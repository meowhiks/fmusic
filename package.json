{
  "name": "yt-music-player",
  "version": "0.1.0",
  "description": "FMusic",
  "main": "index.js",
  "author": "@meowhiks",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "electron-store": "^8.2.0",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.7.0"
  },
  "build": {
    "appId": "com.example.ytmusicplayer",
    "productName": "FMusic",
    "files": [
      "**/*",
      "!dist",
      "!node_modules/.cache/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/favicon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "shortcutName": "FMusic"
    },
    "mac": {
      "icon": "build/icon.icns"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "AppImage"
      ]
    }
  }
}
